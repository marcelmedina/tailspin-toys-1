---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(db),
  getAllCategories(db),
  getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <form class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" aria-label="Filter games" data-testid="game-filters">
        <div class="grid gap-6 md:grid-cols-[2fr_1fr_auto] md:items-end">
          <fieldset>
            <legend class="mb-3 text-sm font-semibold text-slate-200">Categories</legend>
            <div class="flex flex-wrap gap-3">
              {categories.map((category) => (
                <label class="flex cursor-pointer items-center gap-2 text-sm text-slate-300" data-testid={`category-filter-${category.id}`}>
                  <input
                    type="checkbox"
                    name="category"
                    value={category.id}
                    class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                    data-testid="category-filter"
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div>
            <label for="publisher-filter" class="mb-3 block text-sm font-semibold text-slate-200">Publisher</label>
            <select
              id="publisher-filter"
              name="publisher"
              class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-sm text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="publisher-filter"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
            </select>
          </div>

          <button
            type="reset"
            class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="reset-filters"
          >
            Clear filters
          </button>
        </div>
      </form>

      <p class="mb-6 text-sm text-slate-400" role="status" aria-live="polite" data-testid="filter-results-count">
        Showing {games.length} {games.length === 1 ? 'game' : 'games'}
      </p>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}

      <div class="hidden" role="status" aria-live="polite" data-testid="filtered-empty-state">
        <EmptyState text="No games match the selected filters." />
      </div>
    </div>
  </div>
</Layout>

<script>
  const filters = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];
  const resultsCount = document.querySelector<HTMLElement>('[data-testid="filter-results-count"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');

  const updateResults = (): void => {
    if (!filters || !resultsCount || !emptyState || !publisherFilter) {
      return;
    }

    const selectedCategories = new Set(
      [...filters.querySelectorAll<HTMLInputElement>('input[name="category"]:checked')].map(
        (input) => input.value,
      ),
    );
    const selectedPublisher = publisherFilter.value;
    let visibleCount = 0;

    for (const card of cards) {
      const categoryMatches =
        selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
      const publisherMatches =
        selectedPublisher === '' || selectedPublisher === card.dataset.publisherId;
      const isVisible = categoryMatches && publisherMatches;

      card.classList.toggle('hidden', !isVisible);
      if (isVisible) {
        visibleCount += 1;
      }
    }

    resultsCount.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
    emptyState.classList.toggle('hidden', visibleCount !== 0);
  };

  filters?.addEventListener('change', updateResults);
  filters?.addEventListener('reset', () => requestAnimationFrame(updateResults));
</script>
